# Synthetic Users public example config.
# Copy to .env.local only for local development. Do not commit real secrets.

# Optional AI-assisted open-world routing. Leave empty to use deterministic fallback paths.
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_MS=12000

# Optional LLM/vector source DB helpers. Leave empty for JSON/local fallback.
OPENAI_API_KEY=
SOURCE_DB_BACKEND=json_file_postgres_shape

# Optional hosted Shark Mode / MiroShark x402 path. Requires explicit operator confirmation.
MIROSHARK_X402_ENDPOINT=
MIROSHARK_X402_BUYER_PRIVATE_KEY=

# Optional web auth bridge. Public app/client ids only; never put server secrets in browser code.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server/runtime
PORT=8787
PRODUCT_UPDATED_AT=2026-06-07T00:00:00Z
ARTIFACT_RETENTION_MS=604800000
ARTIFACT_CLEANUP_EVERY_MS=21600000
